  },
  "homepage": "https://github.com/tingfeng347/windcode#readme",
  "keywords": [
    "ai",
    "coding-agent",
    "cli",
    "terminal"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.34.5"
}
